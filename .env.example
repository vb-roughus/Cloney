# Cloney-Konfiguration. Kopieren nach .env und anpassen.
# Alle Werte und ihre Standards stehen in cloney/config.py.

CLONEY_DATA_DIR=./data
# Darunter entstehen projects/, voices/, comparisons/ und datasets/.

# --- Engine ----------------------------------------------------------------
# dummy = synthetisches Testsignal ohne Modell (Entwicklung, CI)
# higgs = Higgs Audio v3 über einen lokalen SGLang-Omni-Server, ~11 GB
# f5-de = F5-TTS mit deutschem Finetune, im eigenen Prozess, ~2 GB
CLONEY_ENGINE=higgs
CLONEY_HIGGS_BASE_URL=http://localhost:8000/v1
# Muss dem --model-path des Servers entsprechen. 'cloney doctor' nennt den Namen,
# unter dem der laufende Server das Modell anbietet.
CLONEY_HIGGS_MODEL=bosonai/higgs-audio-v3-tts-4b
# Wie der Server an die Referenzaufnahme kommt. 'base64' schickt sie als
# Data-URL mit und braucht weder Pfadübersetzung noch --allowed-local-media-path.
# 'auto'/'wsl'/'path' schicken stattdessen einen Dateipfad; der Server muss dann
# mit --allowed-local-media-path auf den Stimmenordner gestartet werden.
CLONEY_HIGGS_REFERENCE_MODE=base64

# F5-TTS: Die Dateinamen der deutschen Finetunes sind uneinheitlich. Cloney sieht
# deshalb im Repo nach und wählt selbst -- hier ist nichts einzutragen.
CLONEY_F5_REPO_ID=aihpi/F5-TTS-German
CLONEY_F5_NFE_STEP=32

# Nur setzen, um die Auswahl bewusst zu übersteuern. Ein Name, den es im Repo
# nicht (mehr) gibt, führt zurück zur automatischen Suche.
# CLONEY_F5_CKPT_FILENAME=
# CLONEY_F5_VOCAB_FILENAME=
# CLONEY_F5_CKPT_PATH=
# CLONEY_F5_VOCAB_PATH=

# --- Qualitätskontrolle ----------------------------------------------------
# Ab dieser Zeichenfehlerrate wird ein Satz zur Durchsicht markiert.
CLONEY_CER_THRESHOLD=0.10
CLONEY_MAX_RETRIES=2
CLONEY_ASR_MODEL=large-v3-turbo
CLONEY_ASR_COMPUTE_TYPE=int8

# --- Langform --------------------------------------------------------------
CLONEY_TARGET_CHUNK_SECONDS=20.0
CLONEY_TARGET_LUFS=-16.0

# --- Hugging Face Hub ------------------------------------------------------
# Nicht nötig: die Modelle, die Cloney holt, sind öffentlich, und geladen wird
# nur beim ersten Mal. Ein Token hebt die Ratengrenze für unangemeldete
# Zugriffe an und lässt die Warnung verstummen, die beim Training erscheint.
# Beide Namen wirken -- HF_TOKEN ist der aus der Warnung.
# HF_TOKEN=
