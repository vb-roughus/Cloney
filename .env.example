# Cloney-Konfiguration. Kopieren nach .env und anpassen.
# Alle Werte und ihre Standards stehen in cloney/config.py.

CLONEY_DATA_DIR=./data

# --- Engine ----------------------------------------------------------------
# dummy = synthetisches Testsignal ohne Modell (Entwicklung, CI)
# higgs = Higgs Audio v3 über einen lokalen SGLang-Omni-Server, ~11 GB
# f5-de = F5-TTS mit deutschem Finetune, im eigenen Prozess, ~2 GB
CLONEY_ENGINE=higgs
CLONEY_HIGGS_BASE_URL=http://localhost:8000/v1
CLONEY_HIGGS_MODEL=higgs-audio-v3-tts

# F5-TTS: Die Dateinamen der deutschen Finetunes sind uneinheitlich. Schlägt der
# Download fehl, im Dateibaum des Modells nachsehen und hier eintragen -- oder
# mit CLONEY_F5_CKPT_PATH direkt auf eine lokale Datei zeigen.
CLONEY_F5_REPO_ID=aihpi/F5-TTS-German
CLONEY_F5_CKPT_FILENAME=F5TTS_Base/model_last.safetensors
CLONEY_F5_VOCAB_FILENAME=vocab.txt
CLONEY_F5_NFE_STEP=32

# --- Qualitätskontrolle ----------------------------------------------------
# Ab dieser Zeichenfehlerrate wird ein Satz zur Durchsicht markiert.
CLONEY_CER_THRESHOLD=0.10
CLONEY_MAX_RETRIES=2
CLONEY_ASR_MODEL=large-v3-turbo
CLONEY_ASR_COMPUTE_TYPE=int8

# --- Langform --------------------------------------------------------------
CLONEY_TARGET_CHUNK_SECONDS=20.0
CLONEY_TARGET_LUFS=-16.0
